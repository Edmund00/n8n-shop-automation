        [
          {
            "node": "Send Product Workflow Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select Pending Rows": {
      "main": [
        [
          {
            "node": "Generate Product Drafts",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Product Workflow Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Generate Product Drafts",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Generate Product Drafts": {
      "main": [
        [
          {
            "node": "Validate Drafts",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Product Workflow Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Drafts": {
      "main": [
        [
          {
            "node": "Save Drafts for Approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Product Workflow Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Drafts for Approval": {
      "main": [
        [],
        [
          {
            "node": "Send Product Workflow Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin"
  },
  "pinData": {}
}
